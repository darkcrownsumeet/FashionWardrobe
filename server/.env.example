# Required API Keys
# The pipeline requires all three core API keys to function optimally.
GEMINI_API_KEY=         # Required for Stage 2 (Judge model)
NVIDIA_API_KEY_QWEN=    # Required for Stage 1 (Outfit Generation)
OPENROUTER_API_KEY=     # Required for Stage 4 (Styling)

# Optional Fallback Keys
# Used automatically if the primary provider times out or fails.
NVIDIA_API_KEY_LLAMA=        # Optional fallback for Stage 4
NVIDIA_API_KEY_STAGE2=       # Optional fallback for Stage 2
NVIDIA_API_KEY_DEEPSEEK=     # Optional fallback model
NVIDIA_API_KEY_MINIMAX=      # Optional fallback model


# Server Configuration
PORT=4000

# CORS — set to your frontend origin.
# Required in production. Missing in production will log a startup warning.
FRONTEND_URL=http://localhost:8080

# Debug Mode — enables verbose prompt/response logging and in-memory metrics dump.
# Never enable in production. User prompt content may appear in logs.
DEBUG_PIPELINE=false
