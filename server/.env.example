# Required
GEMINI_API_KEY=

# Optional — OpenRouter fallback provider
# Used when Gemini is unavailable or times out.
OPENROUTER_API_KEY=

# Optional — NVIDIA NIM fallback provider
# Each key maps to a specific model used in the pipeline.
# All are optional. The pipeline runs on GEMINI_API_KEY alone.
NVIDIA_API_KEY_QWEN=         # Qwen model (Stage 1 default NVIDIA model)
NVIDIA_API_KEY_LLAMA=        # Llama model
NVIDIA_API_KEY_STAGE2=       # Stage 2 judge model
NVIDIA_API_KEY_DEEPSEEK=     # DeepSeek model (requires longer timeout)
NVIDIA_API_KEY_MINIMAX=      # MiniMax model (requires longer timeout)

# Server Configuration
PORT=4000

# CORS — set to your frontend origin.
# Required in production. Missing in production will log a startup warning.
FRONTEND_URL=http://localhost:8080

# Debug Mode — enables verbose prompt/response logging and in-memory metrics dump.
# Never enable in production. User prompt content may appear in logs.
DEBUG_PIPELINE=false
